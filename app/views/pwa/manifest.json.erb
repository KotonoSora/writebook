{
  "name": <%= raw(app_name.to_json) %>,
  "icons": [
    {
      "src": "/app-icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/app-icon.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/app-icon.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "description": <%= raw("#{app_name} helps you publish text and pictures in a simple, browsable online book format.".to_json) %>,
  "categories": ["books", "business", "productivity"],
  "shortcuts": [
    {
      "name": "Create a new book",
      "description": <%= raw("Open #{app_name} and start writing".to_json) %>,
      "url": "/books/new",
      "icons": [{ "src": "<%= image_url("add.svg") %>", "sizes": "any" }]
    },
    {
      "name": "Open library",
      "description": <%= raw("Open #{app_name} and see all your books".to_json) %>,
      "url": "/books",
      "icons": [{ "src": "<%= image_url("books.svg") %>", "sizes": "any" }]
    }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff"
}
